# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used by the backend to sign and verify session tokens.
SESSION_SECRET="CHANGE_ME_SESSION_SECRET_KEY"

# DEMO ADMIN CREDENTIALS (Configured on server-side only; never hardcoded in frontend bundle)
COLLEGE_ADMIN_USERNAME="collegeadmin"
COLLEGE_ADMIN_EMAIL="dean@shiftsync.ai"
COLLEGE_ADMIN_BADGE_ID="AD-0102"
COLLEGE_ADMIN_PASSWORD="SET_IN_SERVER_ENV"

CONSTRUCTION_ADMIN_USERNAME="siteadmin"
CONSTRUCTION_ADMIN_EMAIL="siteadmin@shiftsync.ai"
CONSTRUCTION_ADMIN_BADGE_ID="CA-1004"
CONSTRUCTION_ADMIN_PASSWORD="SET_IN_SERVER_ENV"
